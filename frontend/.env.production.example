# Production environment for Vercel deployment
# Copy to .env.production in Vercel dashboard

# Stellar Testnet Contract ID
NEXT_PUBLIC_CONTRACT_ID=CCZDNLCAHHLDG4W4QZLXJ5IQVBIQGK3F6GZLSAEJVZ2AHVTV2CTBTFE

# Stellar network (testnet or public)
NEXT_PUBLIC_NETWORK=testnet

# Hospital query API endpoint
NEXT_PUBLIC_API_URL=https://api.lifemarq.io

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=

# Feature flags
NEXT_PUBLIC_ENABLE_MINISTRY_DASHBOARD=true
NEXT_PUBLIC_ENABLE_HOSPITAL_ONBOARDING=true
NEXT_PUBLIC_ENABLE_DONOR_NOTIFICATIONS=false
